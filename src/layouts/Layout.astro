---
import background from "../assets/background.svg";
import heart_of_olbrich from "../assets/art/paintings/Heart of Olbrich, Digital, 2024.jpg";

import Bio from "../sections/Bio.astro";
import Highlights from "../sections/Highlights.astro";
import Experience from "../sections/Experience.astro";
---

<body>
	<img
		id="background"
		src={heart_of_olbrich.src}
		alt=""
		fetchpriority="high"
	/>
	<main class="my-20 space-y-20">
		<Bio />
		<Highlights />
		<Experience />
	</main>
</body>

<style>
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	#background {
		position: fixed;
		opacity: 50%;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(20px);
	}

	main {
		font-family:
			Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
			sans-serif;

		color: #dacad6;

		max-width: min(100ch, 100% - 4rem);
		margin-inline: auto;
	}
</style>
