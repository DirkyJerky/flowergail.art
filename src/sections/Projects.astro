---
import Roots from "../projects/Roots.astro";
import Currents from "../projects/Currents.astro";
import WeAllBloom from "../projects/WeAllBloom.astro";
import GoghRoom from "../projects/GoghRoom.astro";
---

<section id="projects" class="w-full space-y-8">
	<h1 class="text-5xl font-bold text-center">Mural Highlights</h1>
	<div class="grid grid-cols-1 md:grid-cols-2 max-w-full gap-4">
		<GoghRoom />
		<Currents />
		<Roots />
		<WeAllBloom />
	</div>
</section>

<style scoped>
	h1 {
		color: #dacad6;
	}
</style>
