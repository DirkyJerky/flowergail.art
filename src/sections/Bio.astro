---
import face from "../assets/art/murals/roots/Roots Smiling.jpeg";
import logo from "../assets/Logo.png";
---

<section id="bio">
	<div class="hero">
		<div class="hero-content flex-col lg:flex-row gap-12">
			<a href="mailto:flowergailart@gmail.com">
				<img src={logo.src} class="max-w-md rounded-lg" />
			</a>
			<div class="flex flex-col gap-4 font-bold">
				<p class="text-2xl italic">
					Hello! I’m Gail, a wandering freelance creative specializing
					in public art, murals, scenic design, and mixed medium
					creative painting.
				</p>
				<p class="text-2xl italic font-bold">
					I’ve been painting almost constantly since before I can
					remember, using art as a means for change, joy, love, and
					communication. I believe in making the world more beautiful
					for every person and every critter we share it with.
				</p>
			</div>
		</div>
	</div>
</section>
