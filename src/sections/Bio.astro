---
import face from "../assets/art/murals/roots/Roots Smiling.jpeg";
---

<section id="bio">
	<div class="hero min-h-screen">
		<div class="hero-content flex-col lg:flex-row-reverse">
			<img src={face.src} class="max-w-2xs rounded-lg shadow-2xl" />
			<div class="flex flex-col gap-4">
				<div>
					<h1 class="text-5xl font-semibold">Jillian "Gail" Evans</h1>
					<a
						class="italic text-sm font-light"
						href="mailto:flowergailart@gmail.com"
						>flowergailart@gmail.com</a
					>
				</div>
				<h4 class="text-xl">Muralist, Artist, Writer</h4>
				<p class="text-base">
					Hello! I’m Gail, a freelance creative specializing in public
					art, murals, and 3D art/mixed medium.
				</p>
				<p class="text-sm">
					I’ve been painting almost constantly since before I can
					remember, using art as a means for change, joy, love, and
					communication. I believe in making the world more beautiful
					for every person and every critter we share it with.
				</p>
			</div>
		</div>
	</div>
</section>
