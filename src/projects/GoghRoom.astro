---
import ProjectView from "../components/ProjectView.astro";

import gogh_1 from "../assets/art/murals/gogh/Gogh.png";
import gogh_2 from "../assets/art/murals/gogh/gogh best.png";
import gogh_3 from "../assets/art/murals/gogh/gogh door.png";
import gogh_4 from "../assets/art/murals/gogh/gogh fullish.png";
import gogh_5 from "../assets/art/murals/gogh/gogh good.png";
import gogh_6 from "../assets/art/murals/gogh/gogh jenn and I.png";
import gogh_7 from "../assets/art/murals/gogh/gogh ladder.jpeg";
import gogh_8 from "../assets/art/murals/gogh/gogh reach.jpg";
import gogh_9 from "../assets/art/murals/gogh/gogh2.png";
import ImageCarousel from "../components/ImageCarousel.astro";
---

<ProjectView
    id="gogh"
    title="Gogh Room"
    role="Co-artist, painter"
    description=""
    image_url={gogh_2.src}
    project_type="Mural"
    attribution="Private Commission, 2025"
>
    <ImageCarousel
        id="gogh"
        images={[
            gogh_1,
            gogh_2,
            gogh_3,
            gogh_4,
            gogh_5,
            gogh_6,
            gogh_7,
            gogh_8,
            gogh_9,
        ]}
    />
</ProjectView>
