---
import ProjectView from "../components/ProjectView.astro";

import currents_1 from "../assets/art/murals/currents/currents 1.png";
import currents_2 from "../assets/art/murals/currents/currents 2.png";
import currents_3 from "../assets/art/murals/currents/currents fish.png";
import currents_4 from "../assets/art/murals/currents/current sitting.png";
import currents_5 from "../assets/art/murals/currents/currents sitting.jpg";
import currents_6 from "../assets/art/murals/currents/currents stepstool.png";
import currents_7 from "../assets/art/murals/currents/currents wheat.png";
import ImageCarousel from "../components/ImageCarousel.astro";
---

<ProjectView
    id="currents"
    title="Currents"
    role="Assistant artist, painter"
    description=""
    image_url={currents_2.src}
    project_type="Mural"
    attribution="Kenosha Mural Project, Kenosha, WI, 2025"
>
    <ImageCarousel
        id="currents"
        images={[
            currents_1,
            currents_2,
            currents_3,
            currents_4,
            currents_5,
            currents_6,
            currents_7,
        ]}
    />
</ProjectView>
