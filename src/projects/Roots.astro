---
import roots_splash from "../assets/art/murals/roots/roots best.jpg";
import ProjectView from "../components/ProjectView.astro";

import roots_2 from "../assets/art/murals/roots/Roots Smiling.jpeg";
import roots_3 from "../assets/art/murals/roots/roots decent.jpg";
import roots_4 from "../assets/art/murals/roots/roots face.jpeg";
import roots_5 from "../assets/art/murals/roots/roots good.jpg";
import roots_6 from "../assets/art/murals/roots/roots ladder.jpg";
import roots_7 from "../assets/art/murals/roots/roots reach.jpeg";
import roots_8 from "../assets/art/murals/roots/roots sit.jpg";
import roots_9 from "../assets/art/murals/roots/roots smiley done.png";
import roots_10 from "../assets/art/murals/roots/roots tree.jpg";
import ImageCarousel from "../components/ImageCarousel.astro";
---

<ProjectView
    id="roots"
    title="Roots of our Community"
    role="Assistant artist, painter, design collaborator"
    description=""
    image_url={roots_splash.src}
    project_type="Mural"
    attribution="Willy Street Co-Op, Madison WI, 2024"
>
    <ImageCarousel
        id="roots"
        images={[
            roots_splash,
            roots_2,
            roots_3,
            roots_4,
            roots_5,
            roots_6,
            roots_7,
            roots_8,
            roots_9,
            roots_10,
        ]}
    />
</ProjectView>
