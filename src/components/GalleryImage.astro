---
interface Props {
    id: string;
    title: string;
    image: ImageMetadata;
}

const { id, title, image } = Astro.props;
---

<div
    class="hover-3d cursor-pointer"
    onclick={`document.getElementById("${id}").showModal()`}
>
    <!-- content -->
    <figure class="max-w-100 rounded-2xl aspect-square">
        <img src={image.src} alt={title} class="w-full h-full object-cover" />
    </figure>
    <!-- 8 empty divs needed for the 3D effect -->
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
</div>
<dialog id={id} class="modal">
    <div
        class="modal-box w-11/12 max-w-screen h-5/6 max-h-screen flex flex-col space-y-4"
        onclick={`document.getElementById("${id}").close()`}
    >
        <h3 class="text-lg font-bold">{title}</h3>
        <div class="flex-1 min-h-0">
            <img
                src={image.src}
                alt={title}
                class="w-full h-full object-contain"
            />
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>
